@page
@model Group2_Sportproject.Pages.NFLMatchResultsModel
@{
    ViewData["Title"] = "NFL Match Results";
}

<div class="container py-4">

    <div class="mb-4 d-flex justify-content-between align-items-center">
        <h2>NFL Match Results</h2>
        <a asp-page="/Index" class="btn btn-outline-light">Back Home</a>
    </div>

    <div class="search-filter-group">
        <input type="text" id="homeTeamSearch" class="form-control" placeholder="Search Home Team..." onkeyup="filterTeams()" />
    </div>

    <div class="search-filter-group">
        <input type="text" id="awayTeamSearch" class="form-control" placeholder="Search Away Team..." onkeyup="filterTeams()" />
    </div>

    <div class="nba-standings-card p-3 mb-4">
        <div class="table-responsive">
            <table class="table table-dark table-hover align-middle standings-table mb-0">
                <thead>
                    <tr>
                        <th>Home Team</th>
                        <th>Home Score</th>
                        <th>Away Score</th>
                        <th>Away Team</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var game in Model.Games)
                    {
                        <tr>
                            <td>@game.HomeTeam</td>
                            <td>
                                @if (game.HomeScore > game.AwayScore)
                                {
                                    <span class="fw-bold text-decoration-underline">@game.HomeScore</span>
                                }
                                else
                                {
                                    @game.HomeScore
                                }
                            </td>
                            <td>
                                @if (game.AwayScore > game.HomeScore)
                                {
                                    <span class="fw-bold text-decoration-underline">@game.AwayScore</span>
                                }
                                else
                                {
                                    @game.AwayScore
                                }
                            </td>
                            <td>@game.AwayTeam</td>
                            <td>@game.Status</td>
                            <td>@game.Date.ToLocalTime().ToString("MM/dd/yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<script>
    function filterTeams() {
        const homeInput = document.getElementById('homeTeamSearch').value.toLowerCase();
        const awayInput = document.getElementById('awayTeamSearch').value.toLowerCase();

        const table = document.querySelector('.standings-table tbody'); // Make sure table has class 'standings-table'
        const rows = table.getElementsByTagName('tr');

        for (let row of rows) {
            const homeTeam = row.cells[0].innerText.toLowerCase();
            const awayTeam = row.cells[3].innerText.toLowerCase();

            const matchesHome = !homeInput || homeTeam.includes(homeInput);
            const matchesAway = !awayInput || awayTeam.includes(awayInput);

            row.style.display = (matchesHome && matchesAway) ? '' : 'none';
        }
    }
</script>